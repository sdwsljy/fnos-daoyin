{
  "name": "daoyin",
  "version": "1.1.3",
  "type": "module",
  "private": true,
  "description": "盗音（daoyin）：多平台音乐搜索、试听与高质量下载工具（洛雪音源兼容），面向飞牛 fnOS 原生应用",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 18980",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 18980",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "build:fpk": "bash packaging/fnos/scripts/build-fpk.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.35",
    "@trimjs/web-app": "^0.4.2",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "nuxt": "^4.5.1",
    "qrc-decoder": "1.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
