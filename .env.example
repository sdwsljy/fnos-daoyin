# 访问口令。留空或不设置 = 开放模式（无登录页，API 免鉴权）
# 公网部署请务必设置，例如：AUTH_TOKEN=changeme
AUTH_TOKEN=
SESSION_SECRET=dev-change-me
DATA_DIR=./data
DOWNLOAD_DIR=./downloads
HOST=0.0.0.0
PORT=18980
# 飞牛网关部署时构建/运行使用，例如：/app/daoyin/
# NUXT_APP_BASE_URL=/app/daoyin/
# GATEWAY_PREFIX=/app/daoyin/
# SOCKET_PATH=/tmp/daoyin.sock
