[
  {
    "stepTitle": "访问与鉴权",
    "items": [
      {
        "type": "radio",
        "field": "wizard_auth_mode",
        "label": "访问控制",
        "initValue": "open",
        "options": [
          {
            "label": "关闭鉴权（开放模式，免登录）",
            "value": "open"
          },
          {
            "label": "启用访问口令（需登录）",
            "value": "auth"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择访问控制方式"
          }
        ]
      },
      {
        "type": "password",
        "field": "wizard_auth_token",
        "label": "访问口令（启用鉴权时必填）",
        "initValue": "",
        "rules": [
          {
            "pattern": "^$|^.{6,}$",
            "message": "口令至少 6 位"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "选择「关闭鉴权」可清除已设置的口令，进入开放模式（无登录页）。选择「启用访问口令」则填写口令并登录后使用。修改后将写入配置并重启服务。"
      }
    ]
  },
  {
    "stepTitle": "下载目录",
    "items": [
      {
        "type": "radio",
        "field": "wizard_download_mode",
        "label": "下载目录方式",
        "initValue": "default",
        "options": [
          {
            "label": "默认（使用共享目录 daoyin/downloads）",
            "value": "default"
          },
          {
            "label": "自定义绝对路径（如音乐库挂载点）",
            "value": "custom"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择下载目录方式"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_download_dir",
        "label": "自定义下载目录（绝对路径）",
        "initValue": "",
        "rules": [
          {
            "pattern": "^$|^/.*",
            "message": "请填写以 / 开头的绝对路径，或留空（默认模式）"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "使用自定义目录时：请先选「自定义绝对路径」再填写以 / 开头的路径（只填路径也会自动按自定义处理）。保存后请打开盗音「设置」完成授权并重启。系统应用设置手动授权仍可用作兜底。"
      }
    ]
  }
]
